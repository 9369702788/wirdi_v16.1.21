<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/widget_next_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next Prayer"
        android:textSize="12sp"
        android:textColor="#64748B" />
    <TextView
        android:id="@+id/widget_next_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="24sp"
        android:textColor="#0F766E"
        android:textStyle="bold" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/widget_hadith_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="..."
        android:textSize="13sp"
        android:textColor="#0F766E"
        android:textStyle="bold"
        android:gravity="right" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_wird_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wird: 0/5" android:textSize="11sp" android:textColor="#64748B" />
        <TextView android:id="@+id/widget_khatma_percent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Khatma: 0%" android:textSize="11sp" android:textColor="#64748B" android:gravity="right" />
    </LinearLayout>
</LinearLayout>